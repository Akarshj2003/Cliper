# ==============================================================================
# ClipViral Configuration
# ==============================================================================

# Environment
APP_ENV=development
SECRET_KEY=clipviral-super-secret-development-key-change-in-production
DEBUG=True

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# Note: SQLite fallback is supported if Docker/PostgreSQL is not running.
# Use sqlite+aiosqlite:///./clipviral.db for lightweight local dev.
DATABASE_URL=sqlite+aiosqlite:///./clipviral.db
# PostgreSQL docker-compose URL:
# DATABASE_URL=postgresql+asyncpg://clipviral:clipviral_password@localhost:5432/clipviral

# Redis / Queue
# Note: In-memory background task fallback is supported if Redis is not running.
REDIS_URL=redis://localhost:6379/0
USE_CELERY=False

# Storage (Local filesystem or S3 compatible)
STORAGE_TYPE=local
STORAGE_DIR=./storage
# AWS / S3 Compatible config (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=clipviral-videos

# AI & LLM Provider (for candidate viral scoring)
# Supported: gemini, openai, anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Speech-to-Text (ASR)
# Supported: whisper_local, whisper_api (OpenAI), groq_whisper, deepgram
ASR_PROVIDER=whisper_local
WHISPER_MODEL=base
OPENAI_WHISPER_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# YouTube Integration (Direct YouTube Shorts / Video Publishing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

# Video Download (yt-dlp for clippers)
YT_DLP_MAX_DURATION_SECONDS=7200
YT_DLP_STORAGE_PATH=./storage/downloads

# Render defaults
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
FONT_FAMILY=Impact
